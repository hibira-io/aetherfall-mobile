{
  "appId": "io.hibira.aetherfall",
  "appName": "星核崩落",
  "webDir": "www",
  "ios": {
    "appendUserAgent": "AetherfallApp/ios",
    "contentInset": "never",
    "scheme": "Aetherfall"
  },
  "android": {
    "appendUserAgent": "AetherfallApp/android",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "backgroundColor": "#0b1020"
    }
  }
}
